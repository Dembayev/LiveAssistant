# Скопируй в .env (cp .env.example .env) и заполни. Этот файл не попадает в git.

# Домен сервера. Своего домена нет — используй IP через sslip.io:
# IP 203.0.113.5  →  DOMAIN=203-0-113-5.sslip.io   (HTTPS-сертификат Caddy получит сам)
DOMAIN=

# Ключи моделей — хранятся только на сервере
GROQ_API_KEY=
ANTHROPIC_API_KEY=

# Кто пишет подсказки: anthropic (Claude) или groq. По умолчанию — Claude, если есть его ключ
# LLM_PROVIDER=anthropic
CLAUDE_MODEL=claude-haiku-5-5
CLAUDE_VISION_MODEL=claude-sonnet-5-5
GROQ_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=qwen/qwen3.8-27b

# Лимиты по умолчанию для новых кодов (на день) и общий лимит запросов в минуту
DEFAULT_DAILY_REQUESTS=300
DEFAULT_DAILY_AUDIO_MIN=180
PER_MINUTE_LIMIT=40
